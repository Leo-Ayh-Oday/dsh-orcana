{
  "name": "@leooday/dsh-orcana-linux",
  "version": "0.4.0",
  "description": "dsh-orcana Linux edition — native hardening plus a Windows-to-WSL bridge for one Linux execution world",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leo-Ayh-Oday/dsh-orcana.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sandbox",
    "hardening",
    "resource-limits",
    "egress",
    "prlimit",
    "bwrap",
    "seccomp",
    "linux",
    "wsl",
    "windows"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-orcana": "bin/dsh-orcana-wsl.mjs",
    "dsh-orcana-wsl": "bin/dsh-orcana-wsl.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wsl-bridge": {
      "types": "./lib/types/wsl-bridge.d.ts",
      "default": "./lib/wsl-bridge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/*.mjs",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.5",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.5",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox-local": "0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.5",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
