{
  "name": "@orcana/dsh-orcana-linux",
  "version": "0.3.0",
  "description": "dsh-orcana Linux edition — native hardening layers (resource limits, egress policy, execution evidence) as a DSH plugin over the official sandbox contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leo-Ayh-Oday/dsh-orcana.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sandbox",
    "hardening",
    "resource-limits",
    "egress",
    "prlimit",
    "bwrap",
    "seccomp",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
